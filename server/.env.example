# PostgreSQL connection string supplied by your hosting provider
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
# Set to true when your provider requires TLS (Railway PostgreSQL generally supplies DATABASE_URL)
PGSSL=false
# API port
PORT=4000
# Comma-separated frontend origins, for example https://your-clutch-arena.vercel.app
CORS_ORIGINS=http://localhost:5173
# Generate a long random value for production
APP_SECRET=replace-with-a-long-random-secret