# Copy this file to .env on your server. Never commit the real .env file.
# Use the exact domain you registered, without https:// or a trailing slash.
DOMAIN=your-registered-domain.example

# Use a long random alphanumeric password (at least 32 characters).
POSTGRES_PASSWORD=REPLACE_WITH_LONG_RANDOM_PASSWORD

# Generate a separate long random secret; keep it private.
APP_SECRET=REPLACE_WITH_ANOTHER_LONG_RANDOM_SECRET
